FINLIFE_API_KEY=
GEMINI_API_KEY=
EXTRACTOR_MODEL=gemini-3.7-flash
REVIEWER_MODEL=gemini-3.7-flash
ONLINE_AGENT_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=30
# DB_PATH와 CHECKPOINT_PATH는 생략하면 프로젝트 루트 data/를 사용합니다.
# 경로를 지정하려면 절대경로를 권장합니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Compose uses redis://redis:6379/0 automatically. Manual execution uses memory
# unless REDIS_URL is set. CACHE_ENABLED=false bypasses all application caches.
CACHE_ENABLED=true
# REDIS_URL=redis://127.0.0.1:6379/0
CACHE_PRODUCTS_TTL=3600
CACHE_CALCULATION_TTL=1800
CACHE_LLM_TTL=600
CACHE_RESPONSE_TTL=600
